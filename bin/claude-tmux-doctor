#!/usr/bin/env bash
# Check that every piece of the Claude Code + tmux setup is actually in place.
# Exit status is the number of failed checks, so CI and shell chains can use it.
set -uo pipefail

INSTALL_ROOT=${CLAUDE_TMUX_HOME:-$HOME/.config/claude-tmux}
CLAUDE_SETTINGS=${CLAUDE_SETTINGS:-$HOME/.claude/settings.json}
TPM_DIR=$HOME/.tmux/plugins/tpm

failures=0
warnings=0

pass() { printf '  \033[32mok\033[0m    %s\n' "$1"; }
fail() {
	printf '  \033[31mfail\033[0m  %s\n' "$1"
	[ $# -gt 1 ] && printf '        %s\n' "$2"
	failures=$((failures + 1))
}
warn() {
	printf '  \033[33mwarn\033[0m  %s\n' "$1"
	[ $# -gt 1 ] && printf '        %s\n' "$2"
	warnings=$((warnings + 1))
}
section() { printf '\n%s\n' "$1"; }

need_command() {
	local command_name=$1 hint=$2
	if command -v "$command_name" >/dev/null 2>&1; then
		pass "$command_name found ($(command -v "$command_name"))"
	else
		fail "$command_name not found" "$hint"
	fi
}

section "Dependencies"
need_command tmux "brew install tmux"
need_command claude "https://claude.com/claude-code"
need_command git "xcode-select --install"

if command -v tmux >/dev/null 2>&1; then
	tmux_version=$(tmux -V | awk '{print $2}')
	case "$tmux_version" in
	1.* | 2.*) fail "tmux $tmux_version is too old" "This config needs tmux 3.0 or newer." ;;
	*) pass "tmux version $tmux_version" ;;
	esac
fi

if command -v gitmux >/dev/null 2>&1; then
	pass "gitmux found (git branch appears in the status bar)"
else
	warn "gitmux not found" "brew install gitmux — without it the status bar shows no branch"
fi

section "Files"
for file in tmux.conf gitmux.conf; do
	if [ -r "$INSTALL_ROOT/config/$file" ]; then
		pass "$INSTALL_ROOT/config/$file"
	else
		fail "missing $INSTALL_ROOT/config/$file" "Run install.sh from the repository."
	fi
done

for script in ram.sh load.sh; do
	if [ -x "$INSTALL_ROOT/scripts/$script" ]; then
		output=$("$INSTALL_ROOT/scripts/$script" 2>&1)
		if [ -n "$output" ]; then
			pass "$script prints: $output"
		else
			fail "$script produced no output"
		fi
	else
		fail "missing or non-executable $INSTALL_ROOT/scripts/$script"
	fi
done

if [ -L "$HOME/.tmux.conf" ] && [ "$(readlink "$HOME/.tmux.conf")" = "$INSTALL_ROOT/config/tmux.conf" ]; then
	pass "$HOME/.tmux.conf links to the managed config"
elif [ -e "$HOME/.tmux.conf" ]; then
	warn "$HOME/.tmux.conf is not the managed config" "Run install.sh, or source the managed file from your own config."
else
	fail "$HOME/.tmux.conf does not exist" "Run install.sh."
fi

section "tmux plugins"
if [ -d "$TPM_DIR" ]; then
	pass "tpm installed"
else
	fail "tpm not installed" "Run install.sh, or clone tmux-plugins/tpm into $TPM_DIR"
fi

for plugin in tmux tmux-cpu tmux-battery; do
	if [ -d "$HOME/.tmux/plugins/$plugin" ]; then
		pass "plugin $plugin present"
	else
		fail "plugin $plugin missing" "Run install.sh, or press prefix + I inside tmux."
	fi
done

section "Claude Code settings"
if [ ! -r "$CLAUDE_SETTINGS" ]; then
	fail "$CLAUDE_SETTINGS not readable" "Start Claude Code once to create it, then run install.sh."
elif ! command -v jq >/dev/null 2>&1; then
	warn "jq not found, skipping settings checks" "brew install jq"
else
	check_setting() {
		local path=$1 want=$2 got
		got=$(jq -r "$path // empty" "$CLAUDE_SETTINGS" 2>/dev/null)
		if [ "$got" = "$want" ]; then
			pass "$path = $want"
		else
			fail "$path is '${got:-unset}', expected '$want'" "Run install.sh to patch settings.json."
		fi
	}
	check_setting '.env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS' '1'
	check_setting '.env.CLAUDE_CODE_SPAWN_BACKEND' 'tmux'
	check_setting '.teammateMode' 'tmux'
fi

section "Shell"
for command_name in claude-tmux claude-tmux-cleanup; do
	if command -v "$command_name" >/dev/null 2>&1; then
		pass "$command_name on PATH"
	else
		fail "$command_name not on PATH" "Add ~/.local/bin to PATH, or re-run install.sh."
	fi
done

if grep -Rqs 'temp/claude/tmux-setup' "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" 2>/dev/null; then
	warn "shell rc still points at an old tmux-setup path" "Remove those aliases; claude-tmux now lives in $INSTALL_ROOT."
fi

section "Terminal"
if [ "${TERM_PROGRAM:-}" = "Apple_Terminal" ]; then
	warn "Apple Terminal does not render 24-bit colour" "Use iTerm2, Kitty, WezTerm, Ghostty or Warp for the theme to look right."
else
	pass "terminal is ${TERM_PROGRAM:-unknown}"
fi

printf '\n%d failure(s), %d warning(s)\n' "$failures" "$warnings"
exit "$failures"
